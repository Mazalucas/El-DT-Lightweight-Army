# Copia a vitals/config/project-version.yaml — bootstrap (consumer) o canónico (DT).
# Spec: vitals/specs/project-version.md

version: 1
initialized: false
initial_semver: "0.1.0"
auto_bump: patch
tag_releases: true

# Propagar VERSION (raíz). Tipos: json | readme_badge | yaml_frontmatter
sync_paths:
  - path: README.md
    type: readme_badge
  - path: vitals/config/dt-upstream.md
    type: yaml_frontmatter
    field: framework_version
  - path: package.json
    type: json
    field: version

# Discover automático (script): frontend/package.json, backend/package.json, apps/*/package.json
