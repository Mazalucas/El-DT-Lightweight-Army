# Copiar a vitals/workspace.yaml y ajustar (opcional). No commitear secretos.
# IDs alineados con vitals/catalog/modules.yaml
version: 1
updated: "2026-06-02"
default_project: lucas-prime

projects:
  - id: lucas-prime
    label: "Lucas Prime — segundo cerebro"
    path: .
    git_root: .
    aliases:
      - brain
      - hub
      - prime

  - id: facturas-autonomo-es
    label: "Facturas autónomo (España)"
    path: apps/facturas
    git_root: .
    note: "App local gitignored — no versionada"

