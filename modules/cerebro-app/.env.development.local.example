# Local dev — Firebase emulators (./scripts/dev-cerebro-local.sh)
# Copy to: modules/cerebro-app/src/.env.development.local
# NO usar .env.local para emuladores: Vite lo carga también en build producción.

VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-cerebro
VITE_FIREBASE_STORAGE_BUCKET=demo-cerebro.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:demo
