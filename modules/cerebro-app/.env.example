# Cerebro App — Cloud Functions (production secrets + emulator .env)
# Emulator: copy to modules/cerebro-app/functions/.env
# Production: set via Firebase CLI (see docs/02_guides/cerebro-app-deploy.md)

# Google OAuth Web client (Drive/Docs — distinto del proveedor Google de Firebase Auth)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# API key del mismo proyecto GCP con «Google Picker API» habilitada (browser key)
GOOGLE_PICKER_API_KEY=

# Opcional: número de proyecto GCP (si no se infiere del client ID)
# GOOGLE_CLOUD_PROJECT_NUMBER=

# URL pública Hosting (sin trailing slash)
APP_URL=https://cerebro-prime-a0729.web.app

# Cifrado BYOK API keys (32+ chars aleatorios)
ENCRYPTION_KEY=
