# Production build — Firebase web app cerebro-prime-webapp
# Copy to: modules/cerebro-app/src/.env.production.local
# Values from Firebase Console → Project settings → Your apps → cerebro-prime-webapp

VITE_FIREBASE_API_KEY=
# Browser key con Google Picker API (GCP → Credentials). Si no se define, se intenta VITE_FIREBASE_API_KEY
# tras añadir «Google Picker API» a las restricciones de la key de Firebase en GCP.
VITE_GOOGLE_PICKER_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=cerebro-prime-a0729.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=cerebro-prime-a0729
VITE_FIREBASE_STORAGE_BUCKET=cerebro-prime-a0729.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=338148289911
VITE_FIREBASE_APP_ID=1:338148289911:web:93de5e16ffc5882d728572
VITE_FIREBASE_MEASUREMENT_ID=G-XTD4YQZR5K
